# Optional. Encrypts every stored credential at rest and signs your session
# cookie. Leave blank and the app generates a real random one on first boot,
# saving it to <DATA_DIR>/.secret_key so later restarts reuse the same value —
# set this explicitly only if you want to manage the value yourself.
APP_SECRET_KEY=
APP_PASSWORD=change-me
DATABASE_URL=sqlite:////data/humble.db
# Postgres alternative (see README's "Using PostgreSQL instead of SQLite"):
# DATABASE_URL=postgresql+psycopg://humble:changeme@localhost:5432/humble
# Only consumed by docker-compose.postgres.yml's own ${POSTGRES_PASSWORD}
# substitution (feeds both the postgres service and app's DATABASE_URL there)
# — not a Settings field, the app itself never reads this directly. Leave
# blank/unset for a SQLite-only setup.
POSTGRES_PASSWORD=
DATA_DIR=/data
DOWNLOADS_DIR=/data/downloads
DOWNLOAD_CONCURRENCY=2
# Container-internal path the folder-scan feature is allowed to see (it and its
# subdirectories only, never an arbitrary path) — leave this at its default and
# set SCAN_ROOT instead, which mounts your actual host folder here read-only
# (see docker-compose.yml).
SCAN_ROOT_DIR=/scan-root

# Optional. To scan more than one location instead of the single root above,
# list every mounted root's container path here, comma-separated (mount each
# one in docker-compose.yml's volumes: too — see its own comment on SCAN_ROOT).
# Leave blank to keep the single SCAN_ROOT_DIR behavior above, e.g.
# SCAN_ROOTS=/scan-root,/scan-root-comics
SCAN_ROOTS=

# Optional. /metrics is always reachable without logging in (Prometheus can't do an
# interactive login) — set this to also require a bearer token on that one endpoint.
# Leave unset to scrape it unauthenticated, e.g. on a trusted LAN.
METRICS_TOKEN=

# Optional. Empty/unset disables tracing entirely — no OTLP collector is ever
# contacted. Set to an OTLP/HTTP traces endpoint to enable it, e.g.
# http://tempo:4318/v1/traces (the turnkey Tempo from `docker compose --profile
# observability up` — see README's "Observability" section) or a collector of
# your own.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional. Set to true only once a reverse proxy is terminating real HTTPS in front
# of this app — marks the session/CSRF cookies Secure (browsers refuse to send them
# back over plain HTTP once this is on, so leave it false for local/LAN HTTP use).
# See the README's "Reverse proxy / HTTPS" section before enabling this.
BEHIND_HTTPS_PROXY=false

# Optional. Serve HTTPS directly, with no reverse proxy in front — set BOTH to the
# container-absolute paths of a certificate and its private key, and mount them into
# the container (see README's "HTTPS without a reverse proxy"). Leave blank whenever
# a reverse proxy is terminating TLS instead; setting only one of the two is an error
# the container refuses to start on, rather than silently falling back to HTTP.
SSL_CERTFILE=
SSL_KEYFILE=
# Only if the private key above is itself passphrase-protected.
SSL_KEYFILE_PASSWORD=

# Which GOG storefront the Deals page prices against. GOG's catalogue prices are
# per-market, so these decide the currency and regional pricing you see there.
# Defaults suit a US account; set e.g. GB/GBP or DE/EUR to match yours.
GOG_COUNTRY=US
GOG_CURRENCY=USD

# Optional. When true, the Humble/Steam/GOG connectors talk to a fake backend
# (MOCK_API_BASE_URL) instead of the real APIs, populated with a curated demo
# dataset — see README's "Try it without connecting accounts" section. Only
# useful together with `docker compose --profile demo up`, which starts that
# fake backend; leave both at their defaults for real accounts.
DEMO_MODE=false
MOCK_API_BASE_URL=http://mock-api:8090
